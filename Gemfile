# This file is needed for github pages to build
source "https://rubygems.org"

# Force Jekyll 4.x
gem "jekyll", "~> 4.3"

# GitHub Flavored Markdown parser (preserves markdown: GFM)
gem "kramdown-parser-gfm"

# Add any Jekyll plugins you use (e.g., jekyll-feed, jekyll-seo-tag)
group :jekyll_plugins do
  gem "jekyll-feed"
end